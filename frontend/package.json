{
  "name": "frontend",
  "private": true,
  "version": "v5.5.0-beta.3",
  "description": "A Multi-Script, Multi-Config Management and Automation Software",
  "author": "AUTO-MAS Team",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"yarn watch:main\" \"yarn electron-dev\"",
    "dev:fullstack": "concurrently \"yarn backend\" \"vite\" \"yarn watch:main\" \"yarn electron-dev:wait\"",
    "backend": "cross-env PYTHONIOENCODING=utf-8 AUTO_MAS_HTTP_PORT=36164 python ../main.py",
    "electron-dev:wait": "wait-on http://localhost:5173 http://127.0.0.1:36164/openapi.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "watch:main": "tsc -p tsconfig.electron.json --watch",
    "electron-dev": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "vite build && yarn build:main && electron-builder --publish never",
    "web": "vite",
    "release": "vite build && yarn build:main && electron-builder --win --publish always",
    "release:full": "vite build && yarn build:main && electron-builder --win --publish always --config build-json/electron-builder-full.json",
    "release:lite": "vite build && yarn build:main && electron-builder --win --publish always --config build-json/electron-builder-lite.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "format": "oxfmt . --write",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "openapi": "openapi --input http://127.0.0.1:36164/openapi.json --output ./src/api --client axios",
    "test": "vitest run"
  },
  "build": {
    "asar": true,
    "asarUnpack": [],
    "extraMetadata": {
      "env": "prod"
    },
    "appId": "top.auto-mas.frontend",
    "productName": "AUTO-MAS",
    "files": [
      "dist/index.html",
      "dist/assets/**",
      "!dist/assets/**/*.map",
      "dict/AUTO-MAS.ico",
      "dict/logo.png",
      "dict/prts.png",
      "dist-electron/**",
      "public/**",
      "!src/**",
      "!**/*.map"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AUTO-MAS-Project",
        "repo": "AUTO-MAS"
      }
    ],
    "extraResources": [
      {
        "from": "src/assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "public/AUTO-MAS.ico"
    }
  },
  "dependencies": {
    "@sentry/electron": "7.16.0",
    "@sentry/vue": "10.67.0",
    "adm-zip": "^0.5.16",
    "axios": "1.15.2",
    "electron-log": "^5.4.3",
    "form-data": "^4.0.4",
    "motion-v": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/markdown-it": "^14.1.2",
    "@types/matter-js": "^0",
    "@types/node": "22.17.1",
    "@types/qrcode": "1.5.5",
    "@types/three": "^0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^13.9.0",
    "ant-design-vue": "4.x",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "dayjs": "^1.11.13",
    "electron": "^37.2.5",
    "electron-builder": "26.8.1",
    "electron-builder-squirrel-windows": "26.15.3",
    "markdown-it": "^14.1.1",
    "markdownlint-cli2": "^0.18.1",
    "matter-js": "^0.20.0",
    "monaco-editor": "0.54.0",
    "openapi-typescript-codegen": "^0.29.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "pinia": "^3.0.3",
    "qrcode": "1.5.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.184.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.4",
    "vitest": "^4.1.9",
    "vue": "^3.5.17",
    "vue-i18n": "^11.4.10",
    "vue-router": "4",
    "vue-tsc": "^2.2.12",
    "vuedraggable": "^4.1.0",
    "wait-on": "^8.0.4"
  },
  "resolutions": {
    "@types/node": "22.17.1",
    "ajv@^6.10.0": "6.14.0",
    "ajv@^6.12.0": "6.14.0",
    "ajv@^6.12.4": "6.14.0",
    "flatted": "^3.4.2",
    "dompurify@3.1.7": "3.2.7",
    "lodash-es@^4.17.15": "4.17.23",
    "minimatch@^3.0.4": "3.1.3",
    "minimatch@^3.0.5": "3.1.3",
    "minimatch@^3.1.1": "3.1.3",
    "minimatch@^3.1.2": "3.1.3",
    "minimatch@^5.0.1": "5.1.7",
    "minimatch@^9.0.3": "9.0.6",
    "minimatch@^9.0.4": "9.0.6",
    "minimatch@^10.0.3": "10.2.1",
    "minimatch@^10.1.1": "10.2.1",
    "picomatch@^2.3.1": "2.3.2",
    "picomatch@^4.0.3": "4.0.4",
    "rollup": "4.59.0"
  },
  "packageManager": "yarn@4.9.1"
}
